// Prumo — white-label clinic management system.
//
// Structural rules (see CLAUDE.md):
//  - Every business table carries `tenant_id` and is protected by Row Level Security.
//    Policies live in the `_rls` migration; access always goes through `withTenant()`
//    (src/lib/db.ts), which issues `SET LOCAL app.tenant_id`.
//  - `tenants` and `tenant_domains` are the PLATFORM registry (reseller scope). They
//    carry no tenant_id and are only read in platform scope — the hostname lookup has
//    to happen before we know which tenant we are in.
//  - Code is English, product copy is pt-BR. Column names are snake_case.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (CLI) and in the
// @prisma/adapter-pg driver adapter (runtime) — see src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

/// Access profiles. The module x role matrix lives in src/lib/rbac.ts.
enum Role {
  OWNER // the doctor who owns the clinic — full access
  RECEPTION // front desk / secretary
  FINANCE // finance / bookkeeping
  PRACTITIONER // guest practitioner, limited to their own patients
  SUPERADMIN // reseller super-admin (platform scope, no tenant)
  PATIENT // patient portal

  @@map("role")
}

enum Plan {
  ESSENTIAL
  CLINIC
  NETWORK

  @@map("plan")
}

enum BillingStatus {
  ACTIVE
  PAST_DUE
  TRIAL
  SUSPENDED

  @@map("billing_status")
}

/// A clinic on the platform: branding, domain, plan and enabled modules.
model Tenant {
  id String @id @default(uuid()) @db.Uuid

  name     String
  subtitle String?
  monogram String  @db.VarChar(3)
  logoUrl  String? @map("logo_url")

  /// Accent colour as hex (#rrggbb). Replaces --color-accent at runtime.
  /// The application validates contrast >= 3:1 against the #f3f2f2 background on save.
  accentColor String @map("accent_color") @db.VarChar(7)

  /// The clinic's primary domain (e.g. dratatimayumi.com.br). The hostnames that
  /// actually resolve to this tenant live in `tenant_domains`.
  domain String @unique

  /// Unit name shown under the brand in the navigation.
  defaultUnit String? @map("default_unit")

  plan          Plan          @default(ESSENTIAL)
  billingStatus BillingStatus @default(TRIAL) @map("billing_status")

  /// Per-tenant feature flags (Settings screen). See DEFAULT_FLAGS in src/lib/flags.ts.
  enabledModules Json @default("{}") @map("enabled_modules")

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  domains       TenantDomain[]
  users         User[]
  sessions      Session[]
  auditLogs     AuditLog[]
  loginAttempts LoginAttempt[]
  pricingParams PricingParams[]
  rooms         Room[]
  procedures    Procedure[]
  products      Product[]
  patients      Patient[]
  appointments  Appointment[]

  @@map("tenants")
}

/// Hostnames that resolve to a tenant. A tenant may have several
/// (app.clinic.com.br in production, tati.localhost:3100 in development).
model TenantDomain {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  /// Lowercased host, including the port when there is one (e.g. "tati.localhost:3100").
  host     String  @unique
  primary  Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

/// A system user. `tenantId` is null only for the reseller's SUPERADMIN.
model User {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  name         String
  email        String
  passwordHash String @map("password_hash")
  role         Role

  /// Base32 TOTP secret. Roles that reach medical records require 2FA (see rbac.ts).
  totpSecret      String?   @map("totp_secret")
  totpConfirmedAt DateTime? @map("totp_confirmed_at")

  active     Boolean   @default(true)
  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions Session[]
  auditLogs AuditLog[]
  /// Sessions this user (a SUPERADMIN) opened through "impersonate".
  impersonatedSessions Session[]     @relation("SessionImpersonatedBy")
  appointments         Appointment[] @relation("AppointmentPractitioner")

  /// Email is unique WITHIN a tenant — the same person may exist in two clinics.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// A login session. The cookie holds an opaque token; we only store its hash.
model Session {
  id String @id @default(uuid()) @db.Uuid

  /// SHA-256 HMAC (keyed with SESSION_SECRET) of the token handed to the cookie.
  tokenHash String  @unique @map("token_hash")
  userId    String  @map("user_id") @db.Uuid
  tenantId  String? @map("tenant_id") @db.Uuid

  /// False until the second factor has been verified in this session.
  twoFactorOk Boolean @default(false) @map("two_factor_ok")

  /// Set when the reseller uses "impersonate": holds the originating SUPERADMIN.
  impersonatedByUserId String? @map("impersonated_by_user_id") @db.Uuid
  /// While impersonating, medical records are masked unless explicitly authorised.
  medicalRecordUnlocked Boolean @default(false) @map("medical_record_unlocked")

  ip        String?
  userAgent String? @map("user_agent")

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  impersonatedBy  User?   @relation("SessionImpersonatedBy", fields: [impersonatedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Audit trail — LGPD. Every access to a medical record, anamnesis or photo lands
/// here, along with authentication and configuration-change events.
model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  userId   String? @map("user_id") @db.Uuid

  /// E.g. "login.success", "medicalRecord.view", "tenant.impersonate".
  action String

  /// Kind of resource touched ("patient", "photo", "tenant") and its id.
  resource   String?
  resourceId String? @map("resource_id")

  ip        String?
  userAgent String? @map("user_agent")

  /// Extra context. Never any health data.
  details Json?

  createdAt DateTime @default(now()) @map("created_at")

  // SetNull rather than Cascade: the audit trail outlives both the clinic and the
  // user. With Cascade, deleting a tenant would erase the proof of who read which
  // medical record — precisely the record LGPD requires us to keep.
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_log")
}

/// Login attempts, for throttling per email+IP. Pruned by a job (stage 6).
model LoginAttempt {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  email   String
  ip      String?
  success Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Stage 2 — registrations: pricing parameters, rooms, procedures, products, patients
// ─────────────────────────────────────────────────────────────────────────────
// Money is stored as Decimal, never float: a float drifts once you start summing
// charges. Percentages are stored as fractions (0.06 = 6%), matching the spreadsheet.

/// Pricing parameters, versioned. A new row supersedes the previous one from its
/// `validFrom`; nothing is updated in place, so an old appointment can still be
/// re-explained with the numbers that were in force when it was priced.
model PricingParams {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Tax on revenue, as a fraction (0.06 = 6%).
  taxRate Decimal @map("tax_rate") @db.Decimal(6, 4)
  /// Card fee for a single payment, as a fraction.
  cardFeeUpfront Decimal @map("card_fee_upfront") @db.Decimal(6, 4)
  /// Card fee for instalments, as a fraction.
  cardFeeInstallment Decimal @map("card_fee_installment") @db.Decimal(6, 4)
  /// Everything the clinic pays with an empty diary. Room rent by the hour is NOT
  /// here — it belongs to Room, because it scales with appointments.
  fixedMonthlyCosts Decimal @map("fixed_monthly_costs") @db.Decimal(12, 2)
  /// Realistic appointments per month, used to spread the fixed costs.
  expectedAppointments Int @map("expected_appointments")
  /// Default net margin, as a fraction.
  defaultMargin Decimal @map("default_margin") @db.Decimal(6, 4)

  validFrom DateTime @default(now()) @map("valid_from")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, validFrom])
  @@map("pricing_params")
}

/// A room the clinic rents by the hour. Its cost scales with the appointment, which is
/// why it is not part of the fixed monthly costs.
model Room {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name       String
  hourlyRate Decimal @map("hourly_rate") @db.Decimal(12, 2)
  notes      String?
  active     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products     Product[]
  appointments Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("rooms")
}

/// A procedure the clinic offers. `disposablesCost` covers needles, cannulas, gloves,
/// topical anaesthetic and gauze — it varies by procedure, not by brand.
model Procedure {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name            String
  disposablesCost Decimal @map("disposables_cost") @db.Decimal(12, 2)
  /// Typical chair time, in hours. Drives the room cost and the profit-per-hour figure.
  defaultDurationHours Decimal @map("default_duration_hours") @db.Decimal(5, 2)
  active               Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products     Product[]
  appointments Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("procedures")
}

/// A brand the clinic buys for a procedure. The same procedure usually has several, at
/// different costs — which is the whole point of the pricing sheet.
model Product {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  procedureId String  @map("procedure_id") @db.Uuid
  /// Optional: the room this brand is usually applied in, for the suggested price.
  roomId      String? @map("room_id") @db.Uuid

  brand String
  /// What the clinic pays for one purchased unit.
  purchaseCost Decimal @map("purchase_cost") @db.Decimal(12, 2)
  /// How many appointments one purchased unit serves. Botulinum toxin yields 1.5:
  /// one vial covers one patient and a half, the rest going to a touch-up.
  yieldPerUnit Decimal @map("yield_per_unit") @db.Decimal(10, 4)
  /// What is bought, in the supplier's words: "Frasco 100U", "Seringa 1ml".
  purchaseUnit String  @map("purchase_unit")
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  procedure    Procedure     @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@unique([tenantId, procedureId, brand])
  @@index([tenantId])
  @@index([procedureId])
  @@map("products")
}

/// A patient. Health data proper (anamnesis, photos, encounters) arrives in stage 4 and
/// hangs off this record; what is here is the registration data the front desk handles.
model Patient {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name      String
  birthDate DateTime? @map("birth_date") @db.Date
  /// Stored as typed; formatting for display is the UI's job.
  phone String?
  email String?
  /// CPF. Optional: a first appointment is often booked without it.
  document String?

  /// A short, high-visibility warning shown before any procedure — an allergy, an
  /// anticoagulant, a previous reaction. Not the medical record: this is the line the
  /// practitioner must not miss.
  clinicalAlert String? @map("clinical_alert")
  notes         String?

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, document])
  @@index([tenantId, name])
  @@map("patients")
}

// ─────────────────────────────────────────────────────────────────────────────
// Stage 3 — the schedule
// ─────────────────────────────────────────────────────────────────────────────

/// Where an appointment stands. The encounter itself arrives in stage 4; these are the
/// states the front desk works with.
enum AppointmentStatus {
  CONFIRMED // patient confirmed, usually by WhatsApp
  WAITING // booked, not confirmed yet
  ATTENDED // seen; the encounter record hangs off this from stage 4
  NO_SHOW // did not come, and did not warn
  CANCELLED

  @@map("appointment_status")
}

/// A slot in the diary. `BLOCK` entries carry no patient: they are lunch, travel, or a
/// room that was not booked — the diary has to be able to say "not available" as much as
/// "someone is coming".
model Appointment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Null on a block.
  patientId String? @map("patient_id") @db.Uuid
  roomId    String? @map("room_id") @db.Uuid
  /// What is planned. The brand can still change at the chair, which is why the encounter
  /// records what was actually used (stage 4).
  procedureId String? @map("procedure_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  /// Which practitioner. A guest practitioner only sees their own.
  practitionerId String? @map("practitioner_id") @db.Uuid

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  status AppointmentStatus @default(WAITING)
  /// True for lunch, travel or an unbooked room. Blocks have no patient and no price.
  isBlock Boolean @default(false) @map("is_block")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient?   @relation(fields: [patientId], references: [id], onDelete: SetNull)
  room         Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  procedure    Procedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  practitioner User?      @relation("AppointmentPractitioner", fields: [practitionerId], references: [id], onDelete: SetNull)

  // The day view reads a date range for one tenant; the patient panel reads one patient's
  // history. Both are covered here.
  @@index([tenantId, startsAt])
  @@index([patientId, startsAt])
  @@index([roomId, startsAt])
  @@map("appointments")
}

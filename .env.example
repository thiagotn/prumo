# Postgres — em dev: `npm run db:up` sobe o compose.yaml deste repo.
# Em produção (homelab) vem do secret `prumo-db` no namespace prumo.
DATABASE_URL="postgresql://prumo:prumo@localhost:5434/prumo?schema=public"

# Segredo para derivar o hash dos tokens de sessão (32+ bytes aleatórios).
# openssl rand -hex 32
SESSION_SECRET="troque-isto-em-producao-openssl-rand-hex-32"

# Host usado quando a requisição não tem Host reconhecível (scripts, jobs).
# A resolução normal de tenant é pelo Host da requisição.
TENANT_HOST_FALLBACK="localhost:3100"

# WhatsApp Cloud API (etapa 7). Ausentes, as automações continuam enchendo a fila e nada
# é enviado — a tela de Mensagens avisa que o canal não está conectado.
# Em produção vêm do secret `prumo-whatsapp`.
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TOKEN=""
# Verifica a assinatura do webhook de entrada (X-Hub-Signature-256). Sem ele, nenhuma
# resposta de paciente é aceita.
# WHATSAPP_APP_SECRET=""
# Token do handshake de inscrição do webhook, escolhido por você no painel da Meta.
# WHATSAPP_VERIFY_TOKEN=""

# Hostnames do painel da revenda. Um Host desta lista não é clínica nenhuma: serve o
# painel de tenants, e um login de clínica é recusado ali. Vazio, o painel não existe — é
# assim que um deployment de clínica única fica sem porta de revenda.
# Também define os domínios do produto: admin.prumo.in significa que prumo.in é nosso,
# servido por curinga — e daí saem os rótulos reservados e o atalho do onboarding.
# Em produção: admin.prumo.in
PLATFORM_HOSTS="admin.localhost:3100"
